# JanSahayAI Backend Environment Variables
# Copy this file to .env and fill in your credentials

# Groq API (https://console.groq.com)
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Supabase (https://supabase.com/dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business API (Optional — mocked if not set)
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=jansahayai_secret_token
WHATSAPP_APP_SECRET=

# Tunable thresholds
DEDUP_SIMILARITY_THRESHOLD=0.80
DEDUP_HIGH_CONFIDENCE_THRESHOLD=0.90
DEDUP_LOW_CONFIDENCE_THRESHOLD=0.60
LAYA_DUPLICATE_CONFIRM_THRESHOLD=0.60
LAYA_LOW_CONFIDENCE_REVIEW_THRESHOLD=0.55
GEOFENCE_RADIUS_METERS=150
HOTSPOT_EPS_METERS=100
HOTSPOT_MIN_POINTS=5
